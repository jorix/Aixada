{
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2"
    },
    "scripts": {
        "test":    "./vendor/bin/phpunit test/PHPUnit_aixada_tests.php --testdox --display-all-issues",
        "analyse":          "./vendor/bin/phpstan analyse -c test/phpstan.neon --no-progress --memory-limit 500M",
        "analyse_to_log":   "./vendor/bin/phpstan analyse -c test/phpstan.neon --no-progress --memory-limit 500M > test/logs/phpstan-diagnostic.log 2>&1"
    }
}
